# Skills directory
/skills/
# ══════ ÓRBITA · artefactos regenerables / grandes (no van al repo) ══════
# Modelo ONNX 94MB — se auto-descarga de HuggingFace en el primer render
# (scripts/orbita3d/depth_anything.py::ensure_model) o con scripts/fetch-model.sh
*.onnx
public/models3d/*
!public/models3d/.gitkeep

# Datos y artefactos de render (regenerables)
/db/*.db
/db/*.db-journal
/renders/
/storage/
/upload/
/download/
/tool-results/
/qa/

# Pipeline 3D: intermedios del motor (clips, profundidad, logs)
/scripts/orbita3d/output/
/scripts/orbita3d/depth/
/scripts/orbita3d/*.mp4
/scripts/orbita3d/*.log
/scripts/orbita3d/*.wav
!scripts/orbita3d/input/
!scripts/orbita3d/depth/*_preview.png

# Plataforma sandbox
/dev.log
/server-prod.log
/server.log
/worklog.md
/.gh-pages/
/scripts/github-sync/state/
/.zscripts

# motor: caches y modelos (no versionar)
scripts/orbita3d/cache3d/
data/
prisma/*.db
qa/

# ÓRBITA render engine — intermedios y cachés locales
scripts/orbita3d/output/
scripts/orbita3d/out*/
scripts/orbita3d/cache3d/
scripts/orbita3d/depth/
scripts/orbita3d/dbg/
